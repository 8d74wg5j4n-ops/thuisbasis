<!DOCTYPE html>
<html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#238765"><title>ThuisBasis 1.2</title>
<style>
:root{--green:#238765;--dark:#164c3a;--bg:#f6f8f5;--line:#dfe8e1;--muted:#64746a}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#26382f;font:15px system-ui,Arial,sans-serif}header{background:var(--green);color:white;padding:22px 16px}header h1{margin:0;font-size:28px}header p{margin:6px 0 0}main{max-width:920px;margin:auto;padding:12px}nav{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}button,.button{background:var(--green);color:#fff;border:0;border-radius:10px;padding:11px;cursor:pointer;font:inherit;font-size:13px;text-decoration:none;display:inline-block}button:disabled{opacity:.55}nav button{font-size:11px;padding:12px 3px}nav button.active{background:var(--dark)}.secondary{background:#e4f0e8;color:#18553e}.danger{background:#f9e4e4;color:#a02d2d}.card{background:white;border-radius:15px;padding:15px;margin:12px 0;box-shadow:0 2px 10px #00000008}main>section{display:none}main>section.active{display:block}h2{font-size:23px;margin:20px 3px}h3{font-size:17px;margin:8px 0 12px}input,select,textarea{font:16px Arial;padding:10px;border:1px solid #ccd7ce;border-radius:9px;background:white;color:#26382f;max-width:100%;width:100%}input[type=checkbox]{width:20px;height:20px;accent-color:var(--green)}textarea{min-height:80px}label{display:block;font-size:13px;color:var(--muted);margin:10px 0 5px}.row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:9px 0}.row>*{flex:1;min-width:85px}.row button{flex:0 0 auto}.item{display:flex;align-items:center;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:11px 0}.grow{flex:1;min-width:120px;overflow-wrap:anywhere}.muted{font-size:13px;color:var(--muted)}.tag{font-size:12px;color:var(--green)}.pill{display:inline-block;background:#e4f0e8;color:#18553e;padding:5px 9px;border-radius:20px;font-size:12px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.small{font-size:12px;padding:8px}.chips{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0}.notice{padding:12px;border-radius:10px;background:#fff3d8;margin:10px 0}.success{background:#e4f0e8}.photo{width:72px;height:72px;object-fit:cover;border-radius:9px}details{margin:9px 0}summary{cursor:pointer;font-weight:bold}hr{border:0;border-top:1px solid var(--line);margin:15px 0}footer{text-align:center;padding:20px;color:var(--muted);font-size:12px}.hidden{display:none!important}.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}.link{color:var(--dark);overflow-wrap:anywhere}.loader{padding:12px;background:#e4f0e8;border-radius:10px}@media(max-width:420px){.card{padding:12px}.item button{padding:8px}.row>*{min-width:105px}}
</style></head><body>
<header><h1>🏡 ThuisBasis</h1><p>Meer overzicht. Minder gedoe.</p></header><main>
<nav id="nav"><button data-tab="home">🏠 Home</button><button data-tab="recipes">🍲 Recepten</button><button data-tab="menu">📅 Weekmenu</button><button data-tab="stock">📦 Voorraad</button><button data-tab="shopping">🛒 Boodschappen</button><button data-tab="budget">💶 Budget</button><button data-tab="planning">📋 Planning</button><button data-tab="more">⚙️ Meer</button></nav><p id="status" class="muted">Laden…</p>
<section id="home"><h2>Vandaag thuis</h2><div id="dashboard"></div></section>
<section id="recipes"><h2>Recepten & inspiratie</h2><div class="card"><div class="row"><input id="recipeSearch" placeholder="Zoek in eigen recepten"><select id="recipeFilter"><option value="">Alle soorten</option><option>Ontbijt</option><option>Lunch</option><option>Avondeten</option><option>Snack</option><option>Traktatie</option></select></div><div class="chips"><button class="secondary" onclick="recipeMode='all';renderRecipes()">Alles</button><button class="secondary" onclick="recipeMode='favorites';renderRecipes()">❤️ Favorieten</button><button class="secondary" onclick="recipeMode='possible';renderRecipes()">🥘 Met voorraad</button></div></div><div id="recipeList"></div>
<div class="card"><h3>🌐 Gratis internetrecepten</h3><p class="muted">Zoek via TheMealDB. Meestal Engelstalig; controleer hoeveelheden.</p><div class="row"><input id="webRecipeQuery" placeholder="Bijvoorbeeld chicken, pasta, curry"><button onclick="searchWebRecipes()">Zoeken</button></div><div class="chips"><button class="secondary small" onclick="webSearch('chicken')">Kip</button><button class="secondary small" onclick="webSearch('pasta')">Pasta</button><button class="secondary small" onclick="webSearch('rice')">Rijst</button><button class="secondary small" onclick="webSearch('beef')">Rund</button></div><div id="webRecipeResults"></div><p class="muted"><a class="link" target="_blank" rel="noopener noreferrer" href="https://www.google.com/search?q=recepten">Nederlandse recepten zoeken</a></p></div>
<div class="card"><h3>🥕 Groenten slim verwerken</h3><label>Welke groente?</label><select id="hiddenVeg"><option value="wortel">Wortel</option><option value="courgette">Courgette</option><option value="bloemkool">Bloemkool</option><option value="spinazie">Spinazie</option><option value="pompoen">Pompoen</option><option value="broccoli">Broccoli</option></select><label>In welk gerecht?</label><select id="hiddenDish"><option value="pasta">Pastasaus</option><option value="gehakt">Gehakt / balletjes</option><option value="soep">Soep</option><option value="rijst">Rijstgerecht</option><option value="pannenkoek">Pannenkoeken / beslag</option></select><button onclick="showVegTips()">Geef kooktips</button><div id="vegTips"></div></div>
<div class="card" id="recipeForm"><h3>Eigen recept toevoegen of bewerken</h3><input type="hidden" id="recipeEdit"><label>Naam</label><input id="rName" placeholder="Bijvoorbeeld kip met rijst"><div class="row"><select id="rType"><option>Avondeten</option><option>Ontbijt</option><option>Lunch</option><option>Snack</option><option>Traktatie</option></select><input id="rServings" type="number" min="1" value="4"></div><label>Ingrediënten, één per regel</label><textarea id="rIngredients" placeholder="600 g kipdij&#10;300 g rijst&#10;2 uien"></textarea><label>Bereiding, één stap per regel</label><textarea id="rSteps"></textarea><div class="row"><button onclick="saveRecipe()">Bewaren</button><button class="secondary" onclick="resetRecipe()">Annuleren</button></div></div></section>
<section id="menu"><h2>Weekmenu</h2><div class="card"><h3>Maaltijd plannen</h3><input type="hidden" id="mealEdit"><div class="row"><input id="mealDate" type="date"><select id="mealType"><option>Ontbijt</option><option>Lunch</option><option selected>Avondeten</option><option>Snack</option></select></div><div class="row"><select id="mealRecipe"></select><input id="mealServings" type="number" min="1" value="4"><button onclick="saveMeal()">Plannen</button></div><div class="chips"><button class="secondary" onclick="copyWeek()">Week kopiëren</button><button class="secondary" onclick="menuToShopping()">Boodschappenvoorstel</button></div><p class="muted">Bij 'Gekookt' kun je ingrediënten van je voorraad laten afboeken.</p></div><div id="mealList"></div></section>
<section id="stock"><h2>Mijn voorraad</h2><div class="card"><h3>📦 Voorraadcheck</h3><p class="muted">Controleer je voorraad voor de boodschappenronde.</p><div class="row"><input id="stockSearch" placeholder="Zoek product"><select id="stockLocationFilter"></select></div><div class="chips"><button class="secondary" onclick="stockMode='all';renderStock()">Alles</button><button class="secondary" onclick="stockMode='low';renderStock()">Aanvullen</button><button class="secondary" onclick="stockMode='expiry';renderStock()">Houdbaarheid</button><button onclick="reviewStock()">Voorraadcheck starten</button></div></div>
<div class="card" id="stockForm"><h3>Product toevoegen of bewerken</h3><input type="hidden" id="stockEdit"><label>Productnaam</label><input id="sName" placeholder="Bijvoorbeeld melk"><div class="row"><div><label>Aantal verpakkingen</label><select id="sPacks"><option value="0">0</option><option value="1" selected>1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option><option value="8">8</option><option value="10">10</option><option value="other">Anders...</option></select><input id="sPacksOther" type="number" min="0" step="1" placeholder="Eigen aantal" hidden></div><div><label>Inhoud per verpakking</label><input id="sQty" type="number" min="0.001" step="any" value="1"></div><div><label>Eenheid</label><select id="sUnit"><option value="st">Stuks</option><option value="g">Gram</option><option value="kg">Kilogram</option><option value="ml">Milliliter</option><option value="l">Liter</option></select></div></div><label>Opslaglocatie</label><select id="sLocation"></select><input id="sLocationOther" placeholder="Nieuwe opslaglocatie" hidden><div class="row"><div><label>Gewenste voorraad (verpakkingen)</label><input id="sTarget" type="number" min="0" step="1" value="0"></div><div><label>Houdbaar tot (optioneel)</label><input id="sExpiry" type="date"></div></div><label>Productfoto (optioneel)</label><input id="sPhoto" type="file" accept="image/*"><div class="row"><button onclick="saveStock()">Voorraad bewaren</button><button class="secondary" onclick="resetStockForm()">Annuleren</button><button class="secondary" onclick="scanBarcode()">📷 Barcode</button></div><p class="muted">Bij bewerken kun je de totale hoeveelheid aanpassen. Bij meerdere partijen blijven afzonderlijke houdbaarheidsdatums behouden.</p></div>
<div class="card"><h3>Meerdere producten invoeren</h3><textarea id="bulkInput" placeholder="6 x 1 liter melk&#10;3 pakken rijst&#10;2 flessen wasmiddel"></textarea><label>Opslaglocatie</label><select id="bulkLocation"></select><button onclick="previewBulk()">Invoer controleren</button><div id="bulkPreview"></div></div><div class="card"><h3>📸 Foto's van je voorraad</h3><input id="overviewPhoto" type="file" accept="image/*"><div class="row"><button onclick="saveOverview()">Foto bewaren</button></div><div id="overviewList"></div></div><div id="stockList"></div></section>
<section id="shopping"><h2>🛒 Boodschappen</h2><div class="card" id="shoppingForm"><h3>Product toevoegen of bewerken</h3><input type="hidden" id="shoppingEdit"><label>Productnaam</label><input id="qName" placeholder="Wat heb je nodig?"><div class="row"><div><label>Aantal verpakkingen</label><input id="qQty" type="number" min="1" step="1" value="1"></div><div><label>Winkel</label><select id="qStore"></select></div></div><label>Verwachte totaalprijs (€), optioneel</label><input id="qPrice" type="number" min="0" step="0.01"><div class="row"><button onclick="saveShopping()">Bewaren</button><button class="secondary" onclick="resetShoppingForm()">Annuleren</button></div><div class="chips"><button class="secondary" onclick="addFavorites()">❤️ Favorieten</button><button class="secondary" onclick="reusePurchased()">Eerdere lijst</button><button class="secondary" onclick="tab('shopmode')">🛍️ Winkelmodus</button></div></div><div class="card"><h3>🛒 Nog kopen</h3><div id="pendingList"></div></div><div class="card"><h3>✅ Gekocht</h3><div id="purchasedList"></div><div class="row"><button onclick="finishShopping()">Boodschappen afronden</button><button class="secondary" onclick="clearPurchased()">Gekocht archiveren</button></div><p class="muted">Je kiest wanneer gekochte producten aan de voorraad worden toegevoegd.</p></div></section>
<section id="shopmode"><h2>🛍️ Winkelmodus</h2><div class="card"><label>Bij welke winkel ben je?</label><select id="shopModeStore"></select><p class="muted">Boodschappen zonder vaste winkel worden ook getoond.</p><div id="shopModeList"></div><button onclick="finishShopping()">Boodschappen afronden</button></div><button class="secondary" onclick="tab('shopping')">Terug naar boodschappen</button></section>
<section id="budget"><h2>💶 Budget & uitgaven</h2><div class="card"><h3>Mijn boodschappenbudget</h3><div class="row"><div><label>Weekbudget (€)</label><input id="weeklyBudget" type="number" min="0" step="0.01"></div><div><label>Maandbudget (€)</label><input id="monthlyBudget" type="number" min="0" step="0.01"></div></div><button onclick="saveBudget()">Budget bewaren</button><div id="budgetSummary"></div></div><div class="card"><h3>🧾 Kassabon toevoegen of bewerken</h3><input type="hidden" id="receiptEdit"><div class="row"><div><label>Winkel</label><select id="receiptStore"></select></div><div><label>Datum</label><input id="receiptDate" type="date"></div></div><label>Totaalbedrag (€)</label><input id="receiptTotal" type="number" min="0" step="0.01"><label>Notitie (optioneel)</label><input id="receiptNote" placeholder="Bijvoorbeeld weekboodschappen"><label>Foto van kassabon (optioneel)</label><input id="receiptPhoto" type="file" accept="image/*"><div class="row"><button onclick="saveReceipt()">Kassabon bewaren</button><button class="secondary" onclick="resetReceipt()">Annuleren</button></div><p class="muted">Iedere kassabon telt één keer mee in je uitgaven.</p></div><div class="card"><h3>Uitgavenhistorie</h3><div id="receiptList"></div></div></section>
<section id="planning"><h2>📋 Planning & gezin</h2><div class="card"><h3>Huishoudelijke taken</h3><input type="hidden" id="taskEdit"><label>Taak</label><input id="taskTitle" placeholder="Bijvoorbeeld bedden verschonen"><div class="row"><input id="taskDate" type="date"><select id="taskRepeat"><option value="none">Eenmalig</option><option value="daily">Dagelijks</option><option value="weekly">Wekelijks</option><option value="monthly">Maandelijks</option></select></div><button onclick="saveTask()">Taak bewaren</button><div id="taskList"></div></div><div class="card" id="projectForm"><h3>🎉 School, traktaties & verjaardagen</h3><input type="hidden" id="projectEdit"><label>Naam project</label><input id="projectTitle" placeholder="Bijvoorbeeld brandweerfeest"><div class="row"><select id="projectType"><option>School</option><option>Traktatie</option><option>Verjaardag</option><option>Overig</option></select><input id="projectDate" type="date"></div><label>Budget (€)</label><input id="projectBudget" type="number" min="0" step="0.01"><label>Benodigdheden</label><textarea id="projectItems" placeholder="Ballonnen, rode bekers, servetten, slingers"></textarea><p class="muted">Scheid benodigdheden met komma's, puntkomma's of nieuwe regels.</p><button class="secondary" onclick="previewProjectItems()">Invoer controleren</button><div id="projectPreview"></div><div class="row"><button onclick="saveProject()">Project bewaren</button></div><div id="projectList"></div></div></section>
<section id="more"><h2>⚙️ Meer & instellingen</h2><div class="card"><h3>👨‍👩‍👧‍👦 Gezinsprofielen</h3><p class="muted">Bewaar voorkeuren en allergieën lokaal in je browser. Ze worden niet naar een AI-dienst verstuurd.</p><input type="hidden" id="memberEdit"><label>Naam of bijnaam</label><input id="memberName" placeholder="Bijvoorbeeld Papa"><label>Favoriete gerechten en smaken</label><textarea id="memberLikes" placeholder="Bijvoorbeeld pasta, rijst, kip"></textarea><label>Wat lust dit gezinslid liever niet?</label><textarea id="memberDislikes" placeholder="Bijvoorbeeld rauwe tomaat"></textarea><label>Allergieën of ingrediënten die vermeden moeten worden</label><textarea id="memberAllergies" placeholder="Bijvoorbeeld noten"></textarea><div class="row"><button onclick="saveMember()">Gezinslid bewaren</button><button class="secondary" onclick="resetMember()">Annuleren</button></div><div id="memberList"></div></div><div class="card"><h3>🥘 Koken voor het gezin</h3><p class="muted">Bekijk voorkeuren en aandachtspunten. Controleer allergenen altijd zelf op verpakkingen en in recepten.</p><div id="familyFoodSummary"></div></div><div class="card"><h3>🏷️ Nederlandse aanbiedingen</h3><p class="muted">Winkellinks, geen automatisch ingelezen prijzen.</p><div id="folderList"></div></div><div class="card"><h3>Mijn winkels</h3><div id="storeSettings"></div></div><div class="card"><h3>💾 Back-up & herstel</h3><p class="notice">Maak vóór grote updates of herstel altijd een volledige back-up.</p><div class="row"><button onclick="exportBackup()">Volledige back-up</button><label class="secondary" style="padding:11px;border-radius:10px;text-align:center">Back-up herstellen<input type="file" accept=".json,application/json" style="display:none" onchange="importBackup(event)"></label></div><div class="row"><button class="secondary" onclick="undo()">↩ Laatste wijziging terugdraaien</button><button class="secondary" onclick="storageCheck()">Opslag controleren</button></div><p id="storageInfo" class="muted"></p></div><div class="card"><h3>Wijzigingsgeschiedenis</h3><div id="historyList"></div></div></section>
</main><footer>ThuisBasis 1.2 · Voor thuis, zonder gedoe 💚</footer>
<script>
"use strict";
const $=id=>document.getElementById(id),uid=()=>crypto.randomUUID(),norm=s=>String(s||"").trim().toLocaleLowerCase("nl-NL").replace(/\s+/g," "),esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])),num=v=>Number(v)||0,fmt=n=>new Intl.NumberFormat("nl-NL",{maximumFractionDigits:2}).format(num(n)),euro=n=>new Intl.NumberFormat("nl-NL",{style:"currency",currency:"EUR"}).format(num(n)),clone=x=>structuredClone(x);
function today(){const d=new Date();return [d.getFullYear(),String(d.getMonth()+1).padStart(2,"0"),String(d.getDate()).padStart(2,"0")].join("-")}
function addDays(date,days){const d=new Date(date+"T12:00:00");d.setDate(d.getDate()+days);return [d.getFullYear(),String(d.getMonth()+1).padStart(2,"0"),String(d.getDate()).padStart(2,"0")].join("-")}
function dateNL(d){if(!d)return "Geen datum";const x=new Date(d+"T12:00:00");return isNaN(x)?d:new Intl.DateTimeFormat("nl-NL",{day:"numeric",month:"long",year:"numeric"}).format(x)}
function weekStart(date){const d=new Date(date+"T12:00:00");return addDays(date,-((d.getDay()+6)%7))}
function nextMonth(date){const d=new Date(date+"T12:00:00"),day=d.getDate();d.setDate(1);d.setMonth(d.getMonth()+1);const month=d.getMonth();d.setDate(day);if(d.getMonth()!==month)d.setDate(0);return [d.getFullYear(),String(d.getMonth()+1).padStart(2,"0"),String(d.getDate()).padStart(2,"0")].join("-")}
const storeSeeds=[["Albert Heijn","NL","https://www.ah.nl/bonus"],["Lidl","NL","https://www.lidl.nl/"],["Aldi","NL","https://www.aldi.nl/"],["Jumbo","NL","https://www.jumbo.com/"],["Dirk","NL","https://www.dirk.nl/"],["Hoogvliet","NL","https://www.hoogvliet.com/"],["PLUS","NL","https://www.plus.nl/"],["Kruidvat","NL","https://www.kruidvat.nl/"],["Action","NL","https://www.action.com/nl-nl/"],["Etos","NL","https://www.etos.nl/"],["HEMA","NL","https://www.hema.nl/"],["Trekpleister","NL","https://www.trekpleister.nl/"],["Kaufland","DE",""],["REWE","DE",""],["EDEKA","DE",""],["Netto","DE",""],["Penny","DE",""],["Lidl Duitsland","DE",""],["Aldi Duitsland","DE",""],["dm","DE",""],["Rossmann","DE",""]];
const defaultLocations=["Koelkast","Vriezer","Voorraadkast","Keukenkast","Bijkeuken / berging","Badkamer","Schoonmaakkast","Overige"];
function fresh(){return {version:3,products:[],batches:[],recipes:[],meals:[],shopping:[],receipts:[],tasks:[],projects:[],movements:[],overviews:[],purchaseArchive:[],members:[],stores:storeSeeds.map(([name,country,url])=>({id:uid(),name,country,url,enabled:country==="NL"})),locations:[...defaultLocations],settings:{weeklyBudget:150,monthlyBudget:600}}}
let state=fresh(),db,busy=false,logs=[],currentTab="home",recipeMode="all",stockMode="all",webMeals=[];
function openDB(){return new Promise((resolve,reject)=>{const req=indexedDB.open("thuisbasis-db",2);req.onupgradeneeded=()=>{const d=req.result;for(const name of ["app","photos"])if(!d.objectStoreNames.contains(name))d.createObjectStore(name);if(!d.objectStoreNames.contains("history"))d.createObjectStore("history",{keyPath:"id"})};req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);req.onblocked=()=>reject(Error("Database geblokkeerd"))})}
function get(store,key){return new Promise((resolve,reject)=>{const r=db.transaction(store,"readonly").objectStore(store).get(key);r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}
function getAll(store){return new Promise((resolve,reject)=>{const r=db.transaction(store,"readonly").objectStore(store).getAll();r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}
function getKeys(store){return new Promise((resolve,reject)=>{const r=db.transaction(store,"readonly").objectStore(store).getAllKeys();r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)})}
function write(stores,fn){return new Promise((resolve,reject)=>{const tx=db.transaction(stores,"readwrite");try{fn(tx)}catch(e){tx.abort();reject(e);return}tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error||Error("Transactie afgebroken"))})}
async function mutate(label,fn,photoOps=[]){if(busy||!db){alert("Wacht tot opslaan beschikbaar is.");return false}busy=true;try{const before=clone(state),after=clone(state);fn(after);const entry={id:uid(),date:new Date().toISOString(),label,before};await write(["app","history","photos"],tx=>{tx.objectStore("app").put(after,"state");tx.objectStore("history").put(entry);for(const op of photoOps){if(op.type==="put")tx.objectStore("photos").put(op.data,op.id);else if(op.type==="delete")tx.objectStore("photos").delete(op.id)}});state=after;logs.push({id:entry.id,date:entry.date,label});render();$("status").textContent="✓ Opgeslagen";return true}catch(e){console.error(e);alert("Opslaan mislukt. Bestaande gegevens zijn niet overschreven: "+e.message);return false}finally{busy=false}}
async function undo(){if(busy)return;const entries=(await getAll("history")).sort((a,b)=>b.date.localeCompare(a.date));const last=entries[0];if(!last)return alert("Geen wijziging beschikbaar.");if(!confirm("Laatste wijziging terugdraaien: "+last.label+"?"))return;busy=true;try{await write(["app","history"],tx=>{tx.objectStore("app").put(last.before,"state");tx.objectStore("history").delete(last.id)});state=migrate(last.before);logs=logs.filter(x=>x.id!==last.id);render();alert("Wijziging teruggedraaid. Let op: verwijderde foto's worden niet teruggehaald.")}catch(e){alert("Herstellen mislukt: "+e.message)}finally{busy=false}}
async function storageCheck(){try{const count=(await getKeys("photos")).length,estimate=await navigator.storage?.estimate?.();$("storageInfo").textContent=count+" foto's opgeslagen. Browseropslag: "+(estimate?.usage?(estimate.usage/1048576).toFixed(1)+" MB":"onbekend")+". Maak regelmatig een back-up."}catch(e){$("storageInfo").textContent="Opslagcontrole niet beschikbaar."}}
async function compressPhoto(input){const file=input?.files?.[0];if(!file)return null;return new Promise((resolve,reject)=>{const img=new Image(),url=URL.createObjectURL(file);img.onload=()=>{const canvas=document.createElement("canvas"),factor=Math.min(1,1100/Math.max(img.width,img.height));canvas.width=Math.max(1,Math.round(img.width*factor));canvas.height=Math.max(1,Math.round(img.height*factor));canvas.getContext("2d").drawImage(img,0,0,canvas.width,canvas.height);URL.revokeObjectURL(url);canvas.toBlob(blob=>blob?resolve(blob):reject(Error("Foto verwerken mislukt")),"image/jpeg",.7)};img.onerror=()=>{URL.revokeObjectURL(url);reject(Error("Foto onleesbaar"))};img.src=url})}
async function showPhoto(elementId,photoId){const el=$(elementId);if(!el||!photoId)return;try{const data=await get("photos",photoId);if(!data)return;const src=typeof data==="string"?data:URL.createObjectURL(data);if($(elementId))$(elementId).src=src}catch(e){console.warn(e)}}
function product(s,id){return s.products.find(x=>x.id===id)}
function byName(s,name){return s.products.find(x=>norm(x.name)===norm(name))}
function ensureProduct(s,name,unit="st"){let p=byName(s,name);if(!p){p={id:uid(),name:String(name).trim(),unit,min:0,target:0,favorite:false,category:"Overig"};s.products.push(p)}return p}
function family(unit){return ["g","kg"].includes(unit)?"weight":["ml","l"].includes(unit)?"volume":"count"}
function base(q,unit){return num(q)*(["kg","l"].includes(unit)?1000:1)}
function convert(q,from,to){if(family(from)!==family(to))return null;return base(q,from)/(["kg","l"].includes(to)?1000:1)}
function batchesFor(s,id){return s.batches.filter(x=>x.productId===id)}
function packsFor(s,id){return batchesFor(s,id).reduce((a,b)=>a+num(b.packs??1),0)}
function targetFor(p){return num(p.target??p.min)}
function stockShortage(s,p){return Math.max(0,targetFor(p)-packsFor(s,p.id))}
function stockLabel(s,p){const types=new Map();for(const b of batchesFor(s,p.id)){const key=fmt(b.qty)+" "+b.unit;types.set(key,(types.get(key)||0)+num(b.packs??1))}return [...types].map(([size,count])=>fmt(count)+" × "+size).join(" · ")||"0 verpakkingen"}
function nameOf(id){return product(state,id)?.name||"Onbekend"}
function storeName(id){return state.stores.find(x=>x.id===id)?.name||"Geen winkel"}
function addBatch(s,productId,packs,qty,unit,location,expiry="",photoId=""){if(packs<=0)return;s.batches.push({id:uid(),productId,packs,qty,unit,location,expiry,photoId});s.movements.push({id:uid(),date:new Date().toISOString(),type:"add",productId,packs,qty,unit})}
function addShopping(s,name,packs,source="handmatig",storeId="",price=0,projectId=""){const p=ensureProduct(s,name),amount=Math.max(1,Math.ceil(num(packs)));let q=s.shopping.find(x=>!x.done&&x.productId===p.id&&(x.storeId===storeId||!x.storeId||!storeId));if(q){if(source==="handmatig")q.packs+=amount;else q.packs=Math.max(num(q.packs),amount);if(storeId)q.storeId=storeId;if(num(price)>0)q.estimated=num(price);return q}q={id:uid(),productId:p.id,packs:amount,storeId,estimated:num(price),done:false,stocked:false,source,projectId,created:today()};s.shopping.push(q);return q}
function desiredShopping(s,p,amount){const packs=Math.max(0,Math.ceil(num(amount)));if(!packs)return;const q=s.shopping.find(x=>!x.done&&x.productId===p.id);if(q)q.packs=Math.max(num(q.packs),packs);else addShopping(s,p.name,packs,"aanvullen")}
function unitOf(s){const u=norm(s);if(["g","gr","gram","grammen"].includes(u))return "g";if(["kg","kilo","kilogram"].includes(u))return "kg";if(["l","liter"].includes(u))return "l";if(["ml","milliliter"].includes(u))return "ml";return "st"}
function parseIngredient(line){const text=String(line||"").trim(),m=text.match(/^([\d.,]+)\s*(kg|kilogram|g|gr|gram|grammen|ml|milliliter|l|liter|st|stuk|stuks)?\s+(.+)$/i);if(!m)return{name:text,qty:0,unit:"st",estimated:true};const qty=Number(m[1].replace(",","."));return{name:m[3].trim(),qty:Number.isFinite(qty)?qty:0,unit:unitOf(m[2]||"st"),estimated:!Number.isFinite(qty)}}
function ingredientText(i){return i.estimated?i.name+" (hoeveelheid onbekend)":fmt(i.qty)+" "+i.unit+" "+i.name}
function recipeNeeds(r,servings=r.servings){return r.ingredients.map(i=>{const p=byName(state,i.name),required=num(i.qty)*servings/(num(r.servings)||1),batches=p?batchesFor(state,p.id):[],available=batches.reduce((a,b)=>{const v=convert(b.qty,b.unit,i.unit);return a+(v===null?0:v*num(b.packs??1))},0),uncertain=!!i.estimated||batches.some(b=>family(b.unit)!==family(i.unit));return{...i,required,available,uncertain,missing:Math.max(0,required-available)}})}
function packsNeeded(s,name,missing,unit){const p=byName(s,name);if(!p)return{packs:0,uncertain:true};const matching=batchesFor(s,p.id).filter(b=>family(b.unit)===family(unit)&&num(b.qty)>0);if(!matching.length)return{packs:0,uncertain:true};const sample=matching[0],size=convert(sample.qty,sample.unit,unit);if(!size)return{packs:0,uncertain:true};return{packs:Math.ceil(missing/size),uncertain:matching.some(b=>Math.abs(convert(b.qty,b.unit,unit)-size)>1e-6)}}
function selectedPacks(){return Number($("sPacks").value==="other"?$("sPacksOther").value:$("sPacks").value)}
function setPackSelect(n){const v=String(n);if([...$("sPacks").options].some(x=>x.value===v)){$("sPacks").value=v;$("sPacksOther").hidden=true}else{$("sPacks").value="other";$("sPacksOther").hidden=false;$("sPacksOther").value=n}}
function resetStockForm(){for(const id of ["stockEdit","sName","sExpiry","sPhoto","sLocationOther"])$(id).value="";$("sPacks").value="1";$("sPacksOther").hidden=true;$("sQty").value=1;$("sUnit").value="st";$("sTarget").value=0;$("sLocation").value="Voorraadkast"}
function editStock(id){const p=product(state,id);if(!p)return;const batches=batchesFor(state,id);tab("stock");$("stockEdit").value=id;$("sName").value=p.name;setPackSelect(packsFor(state,id));$("sQty").value=batches[0]?.qty||1;$("sUnit").value=batches[0]?.unit||p.unit;$("sLocation").value=batches[0]?.location||"Voorraadkast";$("sExpiry").value=batches.map(x=>x.expiry).filter(Boolean).sort()[0]||"";$("sTarget").value=targetFor(p);$("stockForm").scrollIntoView({behavior:"smooth"})}
async function saveStock(){const name=$("sName").value.trim(),packs=selectedPacks(),qty=Number($("sQty").value),unit=$("sUnit").value,id=$("stockEdit").value;if(!name||!Number.isInteger(packs)||packs<0||!Number.isFinite(qty)||qty<=0)return alert("Controleer naam, verpakkingen en inhoud.");let location=$("sLocation").value;if(location==="Overige"&&$("sLocationOther").value.trim())location=$("sLocationOther").value.trim();if(!location)return alert("Kies een locatie.");let blob;try{blob=await compressPhoto($("sPhoto"))}catch(e){return alert("Foto verwerken mislukt.")}const photoId=blob?uid():"",expiry=$("sExpiry").value,target=Math.max(0,Math.floor(num($("sTarget").value)));const ok=await mutate("Voorraad bewaren",s=>{let p=id?product(s,id):ensureProduct(s,name,unit);if(!p)throw Error("Product niet gevonden");if(s.products.some(x=>x.id!==p.id&&norm(x.name)===norm(name)))throw Error("Deze productnaam bestaat al");p.name=name;p.unit=unit;p.target=target;p.min=target;if(!s.locations.includes(location))s.locations.push(location);const existing=batchesFor(s,p.id);if(!id||!existing.length){addBatch(s,p.id,packs,qty,unit,location,expiry,photoId);return}const oldCount=packsFor(s,p.id);if(existing.length===1){const b=existing[0];b.packs=packs;b.qty=qty;b.unit=unit;b.location=location;b.expiry=expiry;if(photoId)b.photoId=photoId}else if(packs>oldCount){addBatch(s,p.id,packs-oldCount,qty,unit,location,expiry,photoId)}else if(packs<oldCount){let remaining=oldCount-packs;for(const b of [...existing].sort((a,b)=>(b.expiry||"9999").localeCompare(a.expiry||"9999"))){const take=Math.min(remaining,num(b.packs));b.packs-=take;remaining-=take;if(remaining<=0)break}}s.batches=s.batches.filter(b=>num(b.packs)>1e-6)},blob?[{type:"put",id:photoId,data:blob}]:[]);if(ok)resetStockForm()}
async function quickCount(id){const p=product(state,id);if(!p)return;const answer=prompt("Hoeveel verpakkingen "+p.name+" heb je nog?",packsFor(state,id));if(answer===null)return;const count=Number(answer);if(!Number.isInteger(count)||count<0)return alert("Vul een heel aantal in.");await mutate("Voorraadcheck: "+p.name,s=>{const batches=batchesFor(s,id),difference=count-packsFor(s,id);if(difference>0){const b=batches[0]||{qty:1,unit:p.unit,location:"Voorraadkast"};addBatch(s,id,difference,b.qty,b.unit,b.location,b.expiry||"")}else if(difference<0){let remove=-difference;for(const b of [...batches].sort((a,b)=>(a.expiry||"9999").localeCompare(b.expiry||"9999"))){const take=Math.min(remove,num(b.packs));b.packs-=take;remove-=take;if(remove<=0)break}s.batches=s.batches.filter(b=>num(b.packs)>1e-6)}})}
async function refill(id){const p=product(state,id);if(!p)return;const shortage=stockShortage(state,p);if(!shortage)return alert("Geen aanvulling nodig.");await mutate("Aanvullen: "+p.name,s=>desiredShopping(s,product(s,id),shortage))}
