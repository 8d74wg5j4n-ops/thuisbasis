function fillSelects(){const stores=state.stores.filter(x=>x.enabled).map(x=>({value:x.id,label:x.name}));for(const id of ["qStore","receiptStore","shopModeStore"]){const el=$(id),selected=el.value;el.innerHTML=options(stores,selected,id==="shopModeStore"?"Alle winkels":"Geen vaste winkel")}const locations=state.locations.map(x=>({value:x,label:x}));for(const id of ["sLocation","bulkLocation","stockLocationFilter"]){const el=$(id),selected=el.value;el.innerHTML=options(locations,selected,id==="stockLocationFilter"?"Alle locaties":"Kies locatie");if(!selected&&id!=="stockLocationFilter")el.value="Voorraadkast"}const selected=$("mealRecipe").value;$("mealRecipe").innerHTML=options(state.recipes.map(r=>({value:r.id,label:r.name})),selected,"Kies een recept")}
function renderDashboard(){const low=state.products.filter(p=>stockShortage(state,p)>0).length,pending=state.shopping.filter(q=>!q.done).length,tasks=state.tasks.filter(t=>!t.done).length,meals=state.meals.filter(m=>m.date===today()).length;$("dashboard").innerHTML=`<div class="grid"><div class="card"><h3>📦 Voorraad</h3><p>${state.products.length} producten · ${low} aan te vullen</p><button onclick="tab('stock')">Bekijken</button></div><div class="card"><h3>🛒 Boodschappen</h3><p>${pending} openstaand</p><button onclick="tab('shopping')">Open lijst</button></div><div class="card"><h3>🍽️ Vandaag</h3><p>${meals} maaltijden</p><button onclick="tab('menu')">Weekmenu</button></div><div class="card"><h3>📋 Planning</h3><p>${tasks} taken</p><button onclick="tab('planning')">Bekijken</button></div></div>`}
function render(){fillSelects();renderDashboard();renderStock();renderRecipes();renderMenu();renderShopping();renderBudget();renderPlanning();renderMore();renderHistory()}
function migrate(saved){const defaults=fresh(),result={...defaults,...saved,settings:{...defaults.settings,...(saved.settings||{})}};for(const key of ["products","batches","recipes","meals","shopping","receipts","tasks","projects","movements","overviews","purchaseArchive","members"])if(!Array.isArray(result[key]))result[key]=[];if(!Array.isArray(result.stores)||!result.stores.length)result.stores=defaults.stores;if(!Array.isArray(result.locations)||!result.locations.length)result.locations=defaults.locations;result.recipes=result.recipes.map(r=>({...r,servings:num(r.servings)||4,ingredients:(Array.isArray(r.ingredients)?r.ingredients:typeof r.ingredients==="string"?r.ingredients.split("\n"):[]).map(i=>typeof i==="string"?parseIngredient(i):{name:String(i.name||""),qty:num(i.qty),unit:unitOf(i.unit),estimated:!!i.estimated||!num(i.qty)}),steps:Array.isArray(r.steps)?r.steps:typeof r.steps==="string"?r.steps.split("\n").filter(Boolean):[]}));result.projects=result.projects.map(p=>({...p,items:(Array.isArray(p.items)?p.items:[]).map(i=>typeof i==="string"?{id:uid(),name:i,done:false}:i)}));return result}
async function initialize(){try{db=await openDB();const saved=await get("app","state");if(saved)state=migrate(saved);else{state=fresh();await write(["app"],tx=>tx.objectStore("app").put(state,"state"))}logs=(await getAll("history")).map(x=>({id:x.id,date:x.date,label:x.label})).sort((a,b)=>a.date.localeCompare(b.date));for(const id of ["mealDate","taskDate","receiptDate"])$(id).value=today();document.querySelectorAll("[data-tab]").forEach(button=>button.addEventListener("click",()=>tab(button.dataset.tab)));$("recipeSearch").addEventListener("input",renderRecipes);$("recipeFilter").addEventListener("change",renderRecipes);$("stockSearch").addEventListener("input",renderStock);$("stockLocationFilter").addEventListener("change",renderStock);$("shopModeStore").addEventListener("change",renderShopping);$("sPacks").addEventListener("change",()=>{$("sPacksOther").hidden=$("sPacks").value!=="other"});$("sLocation").addEventListener("change",()=>{$("sLocationOther").hidden=$("sLocation").value!=="Overige"});$("webRecipeQuery").addEventListener("keydown",e=>{if(e.key==="Enter")searchWebRecipes()});render();tab("home");$("status").textContent="✓ Klaar"}catch(e){console.error("Opstartfout",e);alert("ThuisBasis kon niet starten. Verwijder geen bestaande gegevens. "+e.message)}}
initialize();
</script></body></html>
