async function saveRecipe(){const name=$("rName").value.trim(),servings=Number($("rServings").value);if(!name||!Number.isInteger(servings)||servings<1)return alert("Vul naam en porties in.");const id=$("recipeEdit").value,ok=await mutate("Recept bewaren",s=>{const old=s.recipes.find(x=>x.id===id),value={id:id||uid(),name,type:$("rType").value,servings,ingredients:$("rIngredients").value.split("\n").map(x=>x.trim()).filter(Boolean).map(parseIngredient),steps:$("rSteps").value.split("\n").map(x=>x.trim()).filter(Boolean),favorite:old?.favorite||false,sourceUrl:old?.sourceUrl||""};if(old)Object.assign(old,value);else s.recipes.push(value)});if(ok)resetRecipe()}
