function renderStock(){const search=norm($("stockSearch").value),location=$("stockLocationFilter").value;let list=state.products.filter(p=>norm(p.name).includes(search));if(stockMode==="low")list=list.filter(p=>stockShortage(state,p)>0);if(stockMode==="expiry")list=list.filter(p=>batchesFor(state,p.id).some(b=>b.expiry&&b.expiry<=addDays(today(),7)));list=list.filter(p=>!location||batchesFor(state,p.id).some(b=>b.location===location));$("stockList").innerHTML=list.map(p=>{const batches=batchesFor(state,p.id),dates=batches.map(b=>b.expiry).filter(Boolean).sort(),shortage=stockShortage(state,p);return `<div class="card"><div class="row"><h3 class="grow">${esc(p.name)}</h3><button class="secondary small" onclick="favoriteProduct('${p.id}')">${p.favorite?"❤️":"♡"}</button></div><p><b>${esc(stockLabel(state,p))}</b></p><p class="muted">${esc([...new Set(batches.map(b=>b.location).filter(Boolean))].join(", ")||"Geen locatie")}${dates.length?" · Eerste houdbaarheidsdatum: "+dateNL(dates[0]):""}</p><p class="pill">${shortage>0?"Advies: koop "+fmt(shortage)+" verpakking(en)":packsFor(state,p.id)>0?"Op voorraad":"Geen voorraad"}</p><p class="muted">Gewenst: ${fmt(targetFor(p))} verpakkingen</p><div class="row"><button onclick="quickCount('${p.id}')">Aantal aanpassen</button><button class="secondary" onclick="editStock('${p.id}')">Bewerk</button>${shortage>0?`<button class="secondary" onclick="refill('${p.id}')">Aanvullen</button>`:""}<button class="danger small" onclick="deleteProduct('${p.id}')">×</button></div></div>`}).join("")||"<div class='card'>Geen producten gevonden.</div>";$("overviewList").innerHTML=(state.overviews||[]).map(x=>`<div class="item"><img class="photo" id="overview-${x.id}"><span class="grow">${esc(x.label)}</span><button class="danger small" onclick="removeOverview('${x.id}')">×</button></div>`).join("");(state.overviews||[]).forEach(x=>showPhoto("overview-"+x.id,x.id))}
function parseBulk(line){const text=line.trim();let m=text.match(/^(\d+)\s*[x×]\s*([\d.,]+)\s*(liter|l|ml|kg|gram|gr|g|stuks?)\s+(.+)$/i);if(m)return{name:m[4],packs:Number(m[1]),qty:Number(m[2].replace(",",".")),unit:unitOf(m[3])};m=text.match(/^(\d+)\s+(pakken?|flessen?|zakken?|potten?|stuks?)\s+(.+)$/i);if(m)return{name:m[3],packs:Number(m[1]),qty:1,unit:"st"};return null}
function previewBulk(){const lines=$("bulkInput").value.split("\n").map(x=>x.trim()).filter(Boolean),parsed=lines.map(parseBulk);$("bulkPreview").innerHTML=lines.map((line,i)=>`<p>${parsed[i]?"✓":"⚠️"} ${esc(line)}</p>`).join("")+(parsed.length&&parsed.every(Boolean)?`<button onclick="saveBulk()">Alles bewaren</button>`:"")}
async function saveBulk(){const items=$("bulkInput").value.split("\n").map(x=>x.trim()).filter(Boolean).map(parseBulk);if(!items.length||items.some(x=>!x||!Number.isInteger(x.packs)||x.packs<1||!Number.isFinite(x.qty)||x.qty<=0))return alert("Controleer eerst de invoer.");const ok=await mutate("Bulkvoorraad",s=>{for(const item of items){const p=ensureProduct(s,item.name,item.unit);addBatch(s,p.id,item.packs,item.qty,item.unit,$("bulkLocation").value)}});if(ok){$("bulkInput").value="";$("bulkPreview").innerHTML=""}}
