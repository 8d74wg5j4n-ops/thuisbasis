function renderRecipes(){const search=norm($("recipeSearch").value),filter=$("recipeFilter").value;let list=state.recipes.filter(r=>norm(r.name).includes(search)&&(!filter||r.type===filter));if(recipeMode==="favorites")list=list.filter(r=>r.favorite);if(recipeMode==="possible")list=list.filter(r=>r.ingredients.length>0&&recipeNeeds(r).every(n=>!n.uncertain&&n.missing<=0));$("recipeList").innerHTML=list.map(r=>{const needs=recipeNeeds(r);return `<div class="card"><h3>${esc(r.name)}</h3><p class="tag">${esc(r.type)} · ${fmt(r.servings)} porties</p><p>${r.ingredients.map(i=>esc(ingredientText(i))).join(", ")}</p><details><summary>Bereiding & voorraadindicatie</summary>${r.steps.map((step,i)=>`<p>${i+1}. ${esc(step)}</p>`).join("")}${needs.map(n=>`<p>${esc(n.name)}: ${n.uncertain?"Handmatig controleren":"Geschat tekort "+fmt(n.missing)+" "+n.unit}</p>`).join("")}</details><div class="row"><button onclick="recipeToShopping('${r.id}')">Tekorten kopen</button><button class="secondary" onclick="quickPlan('${r.id}')">Plannen</button><button class="secondary small" onclick="editRecipe('${r.id}')">Bewerk</button><button class="secondary small" onclick="favoriteRecipe('${r.id}')">${r.favorite?"❤️":"♡"}</button><button class="danger small" onclick="deleteRecipe('${r.id}')">×</button></div></div>`}).join("")||"<div class='card'>Geen recepten gevonden.</div>"}
async function recipeToShopping(id){const r=state.recipes.find(x=>x.id===id);if(!r)return;const suggestions=[],warnings=[];for(const n of recipeNeeds(r)){if(n.uncertain){warnings.push(n.name);continue}if(n.missing<=0)continue;const result=packsNeeded(state,n.name,n.missing,n.unit);if(result.uncertain)warnings.push(n.name);else suggestions.push({name:n.name,packs:result.packs})}if(warnings.length)alert("Controleer handmatig:\n"+warnings.join("\n")+"\nDeze zijn niet toegevoegd.");if(!suggestions.length)return;if(!confirm("Tekorten toevoegen?\n"+suggestions.map(x=>x.name+": "+x.packs+" verpakking(en)").join("\n")))return;await mutate("Recepttekorten",s=>{for(const item of suggestions)desiredShopping(s,ensureProduct(s,item.name),item.packs)})}
